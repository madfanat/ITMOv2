{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "itmo-tools": {
      "type": "local",
      "command": ["node", ".opencode/mcp/itmo-tools.js"],
      "enabled": true,
      "environment": {}
    }
  },
  "plugin": [
    "./.opencode/plugins/itmo-hooks.js"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "rm *": "ask",
      "*": "ask"
    }
  },
  "tool_output": { "max_lines": 400, "max_bytes": 16384 }
}
