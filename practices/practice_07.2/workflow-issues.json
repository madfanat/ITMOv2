    {
      "name": "Filter opened Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "9a02f52b-58f7-5a5e-b4a5-6feab39c88e2",
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const { body, headers } = $input.first().json;\nconst event = headers?.['x-github-event'];\nconst issue = body?.issue;\nif (event !== 'issues' || body?.action !== 'opened' || body.repository?.full_name !== \"madfanat/ITMOv2\" ||\n    !Number.isSafeInteger(issue?.id) || !Number.isSafeInteger(issue?.number)) {\n  return [];\n}\nreturn [{ json: {\n  repository: body.repository.full_name,\n  issueId: String(issue.id),\n  number: issue.number,\n  title: issue.title,\n  body: issue.body ?? '',\n  author: issue.user.login,\n  association: issue.author_association,\n  createdAt: issue.created_at,\n  delivery: headers['x-github-delivery'],\n} }];"
      }
    },
