    {
      "name": "Apply confidence threshold",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "0a9f0248-7b49-5d8d-8ee2-b39397fe2946",
      "position": [
        1100,
        80
      ],
      "parameters": {
        "jsCode": "const { type, confidence } = $input.first().json;\nconst issue = $('Filter opened Issues').first().json;\nconst confident = ['bug', 'task', 'feature'].includes(type) &&\n  typeof confidence === 'number' && confidence >= 0.8 && confidence <= 1;\nreturn [{ json: { ...issue, modelType: type, confidence, route: confident ? type : 'unknown' } }];"
      }
    },
