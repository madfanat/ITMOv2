    {
      "name": "Prepare bug",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "560ac4e6-47c4-5c3b-aa49-559d83a72ee0",
      "position": [
        1550,
        -160
      ],
      "parameters": {
        "jsCode": "const issue = $input.first().json;\nconst first = issue.association === 'NONE';\nconst labels = [\"bug\"];\nif (first) labels.push('first-time-contributor');\nconst destination = 'https://api.github.com/repos/' + issue.repository + '/issues/' + issue.number;\nconst reply = \"Спасибо за сообщение об ошибке. Если можете, добавьте версию приложения и минимальный пример.\";\nconst greeting = first ? 'Добро пожаловать! [Как внести вклад](https://github.com/' + issue.repository + '/blob/smolyankin-timofey-practice-07-2/practices/practice_07.2/CONTRIBUTING.md).\\n\\n' : '';\nreturn [{ json: { ...issue, labels, destination, reply: reply ? greeting + reply : '' } }];"
      }
    },
