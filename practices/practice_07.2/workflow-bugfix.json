      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"required\": [\"approved\", \"blocking\", \"summary\"], \"additionalProperties\": false, \"properties\": {\"approved\": {\"type\": \"boolean\"}, \"blocking\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"summary\": {\"type\": \"string\"}}}"
      }
    },
    {
      "name": "Decide merge eligibility",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "90942c23-4ae5-5570-861b-63eb21f78a18",
      "position": [
        3080,
        0
      ],
      "parameters": {
        "jsCode": "const value = $input.first().json;\nconst review = value.output ?? value.text ?? value;\nif (typeof review.approved !== 'boolean' || !Array.isArray(review.blocking) ||\n    review.blocking.some(entry => typeof entry !== 'string') || typeof review.summary !== 'string' || !review.summary.trim()) {\n  throw new Error('Review could not be validated');\n}\nconst pr = $('Check PR scope and head').first().json;\nreturn [{ json: { ...pr, approved: review.approved && review.blocking.length === 0, summary: review.summary.trim(),\n  blocking: review.blocking } }];"
      }
    },
