    {
      "name": "Validate owner demo bug",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "4c0772c8-a73c-58ef-9c48-4fd08a85e068",
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const issue = $input.first().json;\nconst authorized = issue.user?.login === 'madfanat' && issue.author_association === 'OWNER';\nif (!authorized || !issue.title.startsWith('[Демо 7.2 автофикс]') ||\n    !issue.labels.some(label => label.name === 'bug') || !issue.body?.includes('sum([])')) {\n  return [];\n}\nreturn [{ json: { number: issue.number, url: issue.html_url, title: issue.title, body: issue.body } }];"
      }
    },
    {
      "name": "Read main SHA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
