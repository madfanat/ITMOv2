      "id": "67bf3754-4e42-536f-8989-af0f820e9433",
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/madfanat/itmo-practice-072-demo/contents/src/sum.mjs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "timeout": 15000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ref",
              "value": "={{ $json.object.sha }}"
            }
          ]
        }
