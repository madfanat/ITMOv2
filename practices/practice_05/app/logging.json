{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"plain": {"format": "%(message)s"}},
  "handlers": {"console": {"class": "logging.StreamHandler", "formatter": "plain", "stream": "ext://sys.stdout"}},
  "loggers": {
    "ai_review.requests": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["console"], "level": "WARNING", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "WARNING", "propagate": false}
  },
  "root": {"handlers": ["console"], "level": "WARNING"}
}
